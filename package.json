{
  "name": "mc-rtx-launcher",
  "version": "1.0.0",
  "description": "Лучший бесплатный лаунчер Minecraft с поддержкой RTX графики",
  "author": "bromachok1589",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "minecraft-launcher-core": "^3.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0",
    "@electron-forge/maker-squirrel": "^6.0.0",
    "electron": "^25.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "mc-rtx-launcher",
            "setupIcon": ""
          }
        }
      ]
    }
  }
}
